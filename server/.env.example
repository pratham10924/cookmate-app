# Copy this file to .env and fill in values.
PORT=3000

# REQUIRED in production: long random string used to sign login tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional: turns on the AI assistant for questions the rule-based parser doesn't understand.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: raises MyMemory's free translation quota (5k -> 50k chars/day).
MYMEMORY_EMAIL=

# Optional: enables PUT /api/recipes/:id and /api/ingredients/:key to add recipes.
ADMIN_KEY=

# Optional: comma-separated origins allowed to call the API (default: any).
CORS_ORIGIN=
